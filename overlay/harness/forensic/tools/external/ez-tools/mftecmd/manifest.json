{
  "id": "mftecmd",
  "name": "MFTECmd ($MFT 解析)",
  "version": "2024",
  "description": "解析 NTFS $MFT 生成文件/目录时间线（Eric Zimmerman MFTECmd）。需将 MFTECmd.exe 及其依赖放入本目录。",
  "executable": { "windows": "MFTECmd.exe" },
  "args": [
    { "name": "file", "type": "string", "required": true, "flag": "-f", "description": "$MFT（或 $J/$Boot）文件路径" },
    { "name": "csvDir", "type": "string", "flag": "--csv", "description": "CSV 输出目录（可选）" }
  ],
  "requires_admin": false,
  "network": { "allowed": false },
  "timeout_ms": 600000
}
